#!/usr/bin/env bpftrace
/*
 * wakeupAggregator.bt
 *
 * Windowed wakeup-edge aggregation for CONTINUOUS monitoring.
 *
 * The raw tracker (wakeupTracker.bt) emits one JSON line per scheduler wakeup,
 * which grows ~500 MB/min under load. This script instead counts
 * (wakee_comm, waker_comm) pairs in-kernel and dumps one compact window every
 * 3 seconds — the same cadence as probes.bt, so windows line up 1:1.
 *
 * Output protocol (plain text, one JSON object per line):
 *
 *   {"marker": "begin",       "nsecs": <boot-relative ns at attach>}
 *   {"marker": "window_end",  "nsecs": <boot-relative ns at interval fire>}
 *   {"wakee": "<comm>", "waker": "<comm>", "count": <n>}      (0..N lines)
 *   {"marker": "window_done"}
 *   ... repeats every 3 s ...
 *
 * Consumers:
 *   wakeupExtractor.py      → converts to data/edgeData_<run_id>.jsonl (epoch stamps)
 *   analyzeCausalGraphs.py  → builds Wakee → Waker causal graphs
 */

BEGIN
{
	printf("{\"marker\":\"begin\",\"nsecs\":%llu}\n", nsecs);
}

tracepoint:sched:sched_wakeup,
tracepoint:sched:sched_wakeup_new
{
	@edges[args.comm, comm] = count();
}

interval:s:3
{
	printf("{\"marker\":\"window_end\",\"nsecs\":%llu}\n", nsecs);
	for ($kv : @edges) {
		printf("{\"wakee\":\"%s\",\"waker\":\"%s\",\"count\":%llu}\n",
			$kv.0.0, $kv.0.1, $kv.1);
	}
	printf("{\"marker\":\"window_done\"}\n");
	clear(@edges);
}
