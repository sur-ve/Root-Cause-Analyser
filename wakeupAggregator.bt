#!/usr/bin/env bpftrace
/*
 * wakeupAggregator.bt
 *
 * Windowed wakeup-edge aggregation for CONTINUOUS monitoring.
 *
 * The raw tracker (wakeupTracker.bt) emits one JSON line per scheduler wakeup,
 * which grows ~500 MB/min under load. This script instead counts
 * (wakee_comm, waker_comm) pairs in-kernel and dumps one compact window every
 * 3 seconds — the same cadence as probes.bt, so windows line up 1:1.
 *
 * Must run with JSON output:  bpftrace -q -f json wakeupAggregator.bt
 *
 * Output per window:
 *   {"type": "printf", "data": "WINDOW_END_NS <boot-relative ns>"}
 *   {"type": "map",    "data": {"@edges": {"<wakee>|<waker>": <count>, ...}}}
 *   {"data": "END"}
 *   ... repeats every 3 s ...
 *
 * Note: bpftrace 0.20.x has no `for` loops, so map contents are emitted with
 * print(@edges) (single string key, wakee|waker) and parsed by wakeupExtractor.py.
 *
 * Consumers:
 *   wakeupExtractor.py      → data/edgeData_<run_id>.jsonl (epoch-stamped windows)
 *   analyzeCausalGraphs.py  → builds Wakee → Waker causal graphs
 */

BEGIN
{
	// attach time on the bpftrace clock — lets wakeupExtractor stamp the first window
	printf("BEGIN_NS %llu\n", nsecs);
}

tracepoint:sched:sched_wakeup,
tracepoint:sched:sched_wakeup_new
{
	// single-string key "wakee|waker" (comm max 15 bytes; '|' is the delimiter)
	@edges[args.comm . "|" . comm] = count();
}

interval:s:3
{
	printf("WINDOW_END_NS %llu\n", nsecs);
	print(@edges);
	print("END");
	clear(@edges);
}
